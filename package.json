{
  "name": "dsh-magpie-quota",
  "version": "0.4.1",
  "description": "All provider quotas and prepaid balances from your local Magpie AI gateway (auto-discovers its port) inside the DSH composer: per-window usage bars, remaining percent, reset countdowns, and money-balance accounts.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hongcheng-LI/dsh-magpie-quota.git"
  },
  "homepage": "https://github.com/Hongcheng-LI/dsh-magpie-quota#readme",
  "bugs": {
    "url": "https://github.com/Hongcheng-LI/dsh-magpie-quota/issues"
  },
  "files": [
    "dsh",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": "./dsh/index.js",
    "./client": "./dsh/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test tests/client.test.mjs tests/host.test.mjs",
    "check": "node --check dsh/index.js && node --check dsh/client.js",
    "preview": "node scripts/preview.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis-plugin",
    "deepseek-harness",
    "magpie",
    "quota",
    "balance"
  ],
  "engines": {
    "node": ">=22"
  }
}
